# ============================================================================
# Supabase Self-Hosted — Configuracao
# ============================================================================
# Copie este arquivo para .env e preencha os valores.
# Gere ANON_KEY e SERVICE_ROLE_KEY com: node scripts/generate-keys.mjs
# Apos gerar, atualize tambem volumes/kong/kong.yml com as mesmas chaves.
# ============================================================================

# ── PostgreSQL externo ───────────────────────────────────────────────────────
# IP/hostname do servidor PostgreSQL (acessivel pelos containers Docker)
POSTGRES_HOST=10.0.0.100
POSTGRES_PORT=5432
POSTGRES_DB=postgres
# Senha do role principal (usada por authenticator, supabase_auth_admin,
# supabase_storage_admin, supabase_admin — todos criados por init-database.sql)
POSTGRES_PASSWORD=sua-senha-segura-aqui

# ── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANTE: troque o secret antes de ir para producao (minimo 32 caracteres)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Gerados a partir do JWT_SECRET (rode: node scripts/generate-keys.mjs)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── URLs ─────────────────────────────────────────────────────────────────────
# URL publica da API (como o browser/client acessa o Supabase)
API_EXTERNAL_URL=https://api.seu-dominio.com.br
# URL do frontend (para redirects de auth)
SITE_URL=https://app.seu-dominio.com.br
# URLs adicionais permitidas em redirects de auth (separadas por virgula)
ADDITIONAL_REDIRECT_URLS=

# ── Auth ─────────────────────────────────────────────────────────────────────
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=true

# ── SMTP (para emails de auth — confirmacao, recovery, invite) ───────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=noreply@seu-dominio.com.br

# ── Studio (Dashboard) ──────────────────────────────────────────────────────
STUDIO_ORG_NAME=Minha Org
STUDIO_PROJECT_NAME=Meu Projeto

# ── Realtime ─────────────────────────────────────────────────────────────────
# Gere um valor aleatorio (ex.: openssl rand -base64 48)
SECRET_KEY_BASE=troque-por-um-valor-aleatorio-de-pelo-menos-64-caracteres-gerado-com-openssl-rand

# ── Storage ──────────────────────────────────────────────────────────────────
# Limite de tamanho de arquivo em bytes (padrao: 50 MB)
STORAGE_FILE_SIZE_LIMIT=52428800
STORAGE_REGION=us-east-1

# ── PostgREST ────────────────────────────────────────────────────────────────
# Schemas expostos pela API REST (separados por virgula)
PGRST_DB_SCHEMAS=public,storage,graphql_public

# ── Edge Functions ───────────────────────────────────────────────────────────
# Se true, o main/index.ts valida JWT em todas as requests
VERIFY_JWT=false

# ── Deploy Service ───────────────────────────────────────────────────────────
# Chave de autenticacao para o deploy-service (usada pelo CLI supabaseself)
DEPLOY_KEY=sua-chave-de-deploy-segura-aqui

# URL publica do deploy-service (usada por scripts/deploy-supabase-prod.mjs)
PROD_DEPLOYER_URL=https://api.seu-dominio.com.br/deploy
# Mesma chave de DEPLOY_KEY (alias para o script Node)
PROD_DEPLOYER_API_KEY=sua-chave-de-deploy-segura-aqui
