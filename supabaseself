# ── Entry point ───────────────────────────────────────────────────────────────
COMMAND="${1:-help}"; [[ $# -gt 0 ]] && shift || true
SUBCOMMAND="${1:-}";  [[ $# -gt 0 ]] && shift || true

ARG1=""
if [[ $# -gt 0 && "${1:0:2}" != "--" ]]; then
  ARG1="$1"; shift
fi

case "${COMMAND} ${SUBCOMMAND}" in
  "functions deploy")     cmd_functions_deploy     "$@" ;;
  "functions logs")       cmd_functions_logs       "$@" ;;
  "functions set-env")    cmd_functions_set_env    "$@" ;;
  "functions get-env")    cmd_functions_get_env    "$@" ;;
  "functions delete-env") cmd_functions_delete_env "$@" ;;
  "db push")              cmd_db_push              "$@" ;;
  "db baseline")          cmd_db_baseline          "$@" ;;
  "db status")            cmd_db_status            "$@" ;;
  "db exec")              cmd_db_exec              "$@" ;;
  "db dump")              cmd_db_dump              "$@" ;;
  "db dump-test")         cmd_db_dump_test         "$@" ;;
  "db dump-head")         cmd_db_dump_head         "$@" ;;
  "db dump-tail")         cmd_db_dump_tail         "$@" ;;
  "db dump-tables")       cmd_db_dump_tables       "$@" ;;
  "db dump-grep")         cmd_db_dump_grep         "$@" ;;
  "docker pull-restart")  cmd_docker_pull_restart  "$@" ;;
  "config ")              cmd_config ;;
  "config"*)              cmd_config ;;
  *)                      usage ;;
esac
